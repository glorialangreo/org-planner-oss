{
  "name": "org-planner",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.export.config.ts",
    "start": "tsx server/index.ts",
    "start:local": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "check:release": "tsx scripts/check-release.ts",
    "release:archive": "npm run check:release && git diff --exit-code HEAD && git archive --format=tar.gz --output=org-planner-source.tgz HEAD",
    "preview:synthetic": "tsx tests/preview.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
